.godot/
.DS_Store
*.tmp
captures/
preview/

# Local experiments; keep only the marker that hides them from Godot.
/experiments/*
!/experiments/.gdignore

# Local credentials and Godot export signing settings.
.env
.env.*
!.env.example
.fal_ai_api_key
.fal_key
export_credentials.cfg

# Release output and staging; hide them from Godot as well as Git.
/dist/*
!/dist/.gdignore
/build/*
!/build/.gdignore

# Local tooling caches.
__pycache__/
*.pyc
.venv/
