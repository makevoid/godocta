name: CI

on:
  push:
  pull_request:
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: ci-${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

jobs:
  godot:
    name: Godot ${{ matrix.godot }} / Linux
    runs-on: ubuntu-latest
    timeout-minutes: 15
    strategy:
      fail-fast: false
      matrix:
        godot: ["4.4.1", "4.7.2"]
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - name: Install official Godot binary
        env:
          GODOT_VERSION: ${{ matrix.godot }}
        run: |
          archive="Godot_v${GODOT_VERSION}-stable_linux.x86_64.zip"
          base="https://github.com/godotengine/godot/releases/download/${GODOT_VERSION}-stable"
          install_dir="$RUNNER_TEMP/godot"
          mkdir -p "$install_dir"
          cd "$install_dir"
          curl --fail --location --retry 3 "$base/$archive" -o "$archive"
          curl --fail --location --retry 3 "$base/SHA512-SUMS.txt" -o SHA512-SUMS.txt
          grep " $archive\$" SHA512-SUMS.txt | sha512sum --check --strict -
          unzip -q "$archive"
          mv "${archive%.zip}" godot
          chmod +x godot
          echo "$install_dir" >> "$GITHUB_PATH"
      - name: Import and run Godot suites
        run: python3 tools/check.py --only godot

  go:
    name: Go ${{ matrix.go }} / ${{ matrix.os }}
    runs-on: ${{ matrix.os }}
    timeout-minutes: 15
    strategy:
      fail-fast: false
      matrix:
        os: [ubuntu-latest, macos-latest, windows-latest]
        go: [stable]
        include:
          - os: ubuntu-latest
            go: "1.22.x"
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - uses: actions/setup-go@b7ad1dad31e06c5925ef5d2fc7ad053ef454303e # v7.0.0
        with:
          go-version: ${{ matrix.go }}
          cache: false # This module has no third-party dependencies or go.sum.
      - name: Format, vet, and test
        run: python tools/check.py --only go
